# X API v2 app-only bearer token (Basic tier or higher: recent search needs read access)
X_BEARER_TOKEN=
# the account whose engagements get ingested (no @)
GVON_HANDLE=STACCoverflow
# teacher model backend: "claude-cli" (uses `claude -p`, your Claude Code login) or "sdk" (needs ANTHROPIC_API_KEY)
GVON_TEACHER=claude-cli
GVON_TEACHER_MODEL=claude-opus-5-5
# Optional explicit override of the local classifier threshold. Leave unset to use the threshold that
# training learned from out-of-fold precision (models/latest/config.json); setting it also forces text
# scoring on even when training disabled it for missing its precision target.
# GVON_THRESHOLD=0.6
# Optional: text-score only tweets engaging you (default "engagements") or every tweet ("all")
# GVON_TEXT_SCOPE=engagements
