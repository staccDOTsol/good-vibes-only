# X API v2 app-only bearer token (Basic tier or higher: recent search needs read access)
X_BEARER_TOKEN=
# the account whose engagements get ingested (no @)
GVON_HANDLE=STACCoverflow
# teacher model backend: "claude-cli" (uses `claude -p`, your Claude Code login) or "sdk" (needs ANTHROPIC_API_KEY)
GVON_TEACHER=claude-cli
GVON_TEACHER_MODEL=claude-opus-5-5
# Optional explicit override of the local classifier threshold. Leave unset to use the threshold that
# training learned from out-of-fold precision (models/latest/config.json); setting it also forces text
# scoring on even when training disabled it for missing its precision target.
# GVON_THRESHOLD=0.6
# Optional: text-score only tweets engaging you (default "engagements") or every tweet ("all")
# GVON_TEXT_SCOPE=engagements
# Operative per-author verdict: "teacher" (default; the frontier teacher's call, one scam accusation can
# block) or "derived" (stricter code rule: >= 2 nullify posts that are most of the author's posts, or one severe hit)
# GVON_VERDICT_POLICY=teacher
# Telegram (user account via Telethon): api id/hash from https://my.telegram.org -> API development tools.
# Log in once with `make telegram-login` (writes data/telegram.session, gitignored).
TG_API_ID=
TG_API_HASH=
# Optional: a Telethon StringSession used INSTEAD of data/telegram.session by BOTH `telegram_ingest pull` and
# the sink (`make telegram`), never by `make telegram-login`. The sink then deletes/mutes on THAT account; it
# logs the account id/username it authorized as at startup.
# TG_SESSION=
# Optional: your Telegram username as shown to the teacher (default: the logged-in account's username)
# GVON_TG_HANDLE=
# Telegram sink (`make telegram`, docs/TELEGRAM.md). Actions: delete_for_me | mute | archive | log.
# delete_for_me only exists in private chats and basic groups; in supergroups/channels the sink mutes instead.
# It never marks chats read (no read receipts) unless GVON_TG_MARK_READ=1.
GVON_TG_DM_ACTION=delete_for_me
GVON_TG_GROUP_ACTION=log
# 1 = delete for EVERYONE in groups (never broadcast channels) where you are an admin with delete rights (off by default)
GVON_TG_GROUP_DELETE=0
# 1 = after a fallback mute, mark the chat read when the flagged message is its only unread one (sends read receipts)
# GVON_TG_MARK_READ=0
# Telegram user ids / usernames the sink never acts on (777000 and Telegram support accounts are always exempt)
# GVON_TG_ALLOW=
# Largest attachment (MB) saved to the vault before a delete; a message whose attachment is not saved is only logged
# GVON_TG_MEDIA_MAX_MB=50
